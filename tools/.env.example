# 360 扫地机登录凭据（get_sid.py / renew_sid.py 使用）
# 复制本文件为 .env 并填入你的账号密码。.env 已在 .gitignore 中，不会被提交。
#
# 账号：注册 360 智能管家 App 时用的手机号或邮箱
VACUUM_360_ACCOUNT=13800138000

# 密码：360 账号密码（明文，仅本地使用）
VACUUM_360_PASSWORD=your_password_here

# 设备 SN（可选）：填了会在验证 sid 时确认目标设备在线；不填只检查账号能否登录
# VACUUM_360_DEVICE_SN=360CNXXXXXXXXXXXX

# HA 配置（renew_sid.py 用，按你的实际安装路径修改）
# VACUUM_360_HA_CONFIG=/opt/homeassistant/config
# VACUUM_360_HA_CONTAINER=homeassistant

# chromium 路径（get_sid.py 用，默认 /usr/bin/chromium）
# VACUUM_360_CHROME=/usr/bin/chromium
